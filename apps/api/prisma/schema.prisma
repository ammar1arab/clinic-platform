generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  practitioner
  financial
}

enum SessionType {
  in_person
  online
}

enum AppointmentStatus {
  unconfirmed
  confirmed
  checked_in
  waiting
  in_progress
  completed
  no_show
  cancelled
}

enum CalendarView {
  day
  week
  month
}

enum ReferralType {
  referral
  consultation
}

enum ReferralUrgency {
  normal
  high
  urgent
}

enum DiscountType {
  fixed
  percentage
}

enum ReferralStatus {
  pending
  accepted
  rejected
}

enum EmploymentType {
  salaried
  commission
  mixed
}

model Clinic {
  scheduleRequests PractitionerScheduleRequest[]
  id                   String       @id @default(uuid())
  name                 String
  nameAr               String?
  email                String?
  phone                String?
  address              String?
  logoUrl              String?
  brandColor           String?
  letterheadFooter     String?
  workingHoursStart    String       @default("08:00")
  workingHoursEnd      String       @default("20:00")
  defaultCalendarView  CalendarView @default(month)
  defaultSessionType   SessionType  @default(in_person)
  defaultNoteTemplateId String?
  defaultNoteTemplate ClinicalNoteTemplate? @relation("ClinicDefaultNote", fields: [defaultNoteTemplateId, id], references: [id, clinicId], onDelete: Restrict, onUpdate: NoAction)
  defaultDepartmentId  String?
  timezone             String       @default("UTC")
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  users           ClinicUser[]
  departments     Department[]
  rooms           Room[]
  services        Service[]
  patients        Patient[]
  appointments    Appointment[]
  referrals       Referral[]
  paymentMethods  PaymentMethod[]
  packages        Package[]
  patientPackages PatientPackage[]
  discountCodes   DiscountCode[]
  notifications   Notification[]
  emailMessages     EmailMessage[]
  emailSettings     EmailSettings?
  emailSuppressions EmailSuppression[]
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  emailVerifiedAt    DateTime?
  passwordChangedAt  DateTime?
  lastSignInAt       DateTime?
  createdAt          DateTime @default(now())

  clinicUsers ClinicUser[]
  otpChallenges AuthOtpChallenge[]
}

enum AuthOtpPurpose {
  EMAIL_VERIFY
  FORGOT_PASSWORD
}

model AuthOtpChallenge {
  id          String @id @default(uuid())
  userId      String?
  email       String
  purpose     AuthOtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int @default(0)
  lastSentAt  DateTime @default(now())
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  id        String @id
  count     Int @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ClinicUser {
  scheduleRequests PractitionerScheduleRequest[] @relation("ScheduleRequester")
  reviewedScheduleRequests PractitionerScheduleRequest[] @relation("ScheduleReviewer")
  defaultNoteTemplateId String?
  notificationPrefs Json?
  id               String          @id @default(uuid())
  userId           String
  clinicId         String
  role             Role
  name             String
  nameAr           String?
  title            String?
  phone            String?
  whatsapp         String?
  nationality      String?
  specialty        String?
  specialtyAr      String?
  languages        String[]        @default([])
  initials         String?
  dob              DateTime?
  gender           String?
  bio              String?
  bioAr            String?
  experienceYears  Int?
  imageUrl         String?
  licenseNumber    String?
  licenseExpiry    DateTime?
  departmentId     String?
  defaultRoomId    String?
  employmentType   EmploymentType?
  commissionPercent Decimal?       @db.Decimal(5, 2)
  calendarColor    String?
  bufferMins       Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  clinic            Clinic               @relation(fields: [clinicId], references: [id])
  department        Department?          @relation(fields: [departmentId], references: [id])
  defaultRoom       Room?                @relation("PractitionerDefaultRoom", fields: [defaultRoomId], references: [id])
  appointments      Appointment[]        @relation("DoctorAppointments")
  referralsSent     Referral[]           @relation("ReferralFrom")
  referralsReceived Referral[]           @relation("ReferralTo")
  primaryPatients   Patient[]            @relation("PrimaryDoctorPatients")
  availabilities    DoctorAvailability[]
  timeOffs          DoctorTimeOff[]
  availabilityOverrides DoctorAvailabilityOverride[]
  notifications     Notification[]
  appointmentsPaid  Appointment[]        @relation("PaidByStaff")
  services          ClinicUserService[]

  @@unique([userId, clinicId])
  @@index([clinicId, role])
}

model Department {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  rooms        Room[]
  services     Service[]
  appointments Appointment[]
  practitioners ClinicUser[]
}

model Room {
  id           String   @id @default(uuid())
  clinicId     String
  departmentId String?
  name         String
  nameAr       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic              Clinic       @relation(fields: [clinicId], references: [id])
  department          Department?  @relation(fields: [departmentId], references: [id])
  appointments        Appointment[]
  defaultPractitioners ClinicUser[] @relation("PractitionerDefaultRoom")
}

model Service {
  id             String        @id @default(uuid())
  clinicId       String
  departmentId   String?
  name           String
  nameAr         String?
  durationMins   Int           @default(45)
  fee            Decimal       @db.Decimal(10, 3)
  supportedModes SessionType[] @default([in_person, online])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic       Clinic             @relation(fields: [clinicId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  practitioners ClinicUserService[]
}

model ClinicUserService {
  id           String @id @default(uuid())
  clinicUserId String
  serviceId    String

  clinicUser ClinicUser @relation(fields: [clinicUserId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([clinicUserId, serviceId])
  @@index([serviceId])
}

model Patient {
  id       String @id @default(uuid())
  clinicId String

  firstNameEn           String
  lastNameEn            String
  firstNameAr           String?
  lastNameAr            String?
  nationalId            String?
  phone                 String?
  email                 String?
  dob                   DateTime?
  gender                String?
  bloodType             String?
  allergies             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  imageUrl              String?

  primaryDoctorId String?
  packageId       String?
  discountCodeId  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  primaryDoctor   ClinicUser?      @relation("PrimaryDoctorPatients", fields: [primaryDoctorId], references: [id])
  package         Package?         @relation(fields: [packageId], references: [id])
  discountCode    DiscountCode?    @relation(fields: [discountCodeId], references: [id])
  appointments    Appointment[]
  patientPackages PatientPackage[]
}

model Appointment {
  revision Int @default(0)
  presenceConfirmedAt DateTime?
  presenceConfirmedById String?
  presenceSource String?
  visit Visit?
  id              String            @id @default(uuid())
  clinicId        String
  patientId       String
  doctorId        String
  departmentId    String?
  roomId          String?
  serviceId       String?
  scheduledAt     DateTime
  durationMins    Int               @default(45)
  sessionType     SessionType       @default(in_person)
  status            AppointmentStatus @default(unconfirmed)
  statusReason      String?
  statusUpdatedBy   String?
  statusUpdatedAt   DateTime?

  waitingStartedAt  DateTime?
  inProgressAt      DateTime?

  waitingMins       Int?
  cancelReason      String?
  notes             String?
  fee              Decimal?          @db.Decimal(10, 3)
  discount         Decimal?          @db.Decimal(10, 3)
  discountType     DiscountType?
  discountReason   String?
  discountCodeId   String?
  isPaid           Boolean           @default(false)
  paidAt           DateTime?
  paidById         String?
  paymentMethod    String?
  paymentMethodId  String?
  patientPackageId String?

  packageCredit    Decimal?          @db.Decimal(10, 3)
  meetingUrl       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  clinic             Clinic         @relation(fields: [clinicId], references: [id])
  patient            Patient        @relation(fields: [patientId], references: [id])
  doctor             ClinicUser     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  department         Department?    @relation(fields: [departmentId], references: [id])
  room               Room?          @relation(fields: [roomId], references: [id])
  service            Service?       @relation(fields: [serviceId], references: [id])
  paymentMethodRef   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  discountCode       DiscountCode?   @relation(fields: [discountCodeId], references: [id])
  paidBy             ClinicUser?     @relation("PaidByStaff", fields: [paidById], references: [id])
  patientPackage     PatientPackage? @relation(fields: [patientPackageId], references: [id])
  referrals          Referral[]

  @@index([clinicId, scheduledAt])
  @@index([clinicId, doctorId, scheduledAt])
  @@index([clinicId, status])
  @@index([clinicId, departmentId, scheduledAt])
  @@index([clinicId, patientId, isPaid])
  @@unique([id, clinicId])
}

model Referral {
  id            String          @id @default(uuid())
  clinicId      String
  appointmentId String
  fromDoctorId  String
  toDoctorId    String
  type          ReferralType    @default(referral)
  urgency       ReferralUrgency @default(normal)
  reason        String
  opinion       String?
  status        ReferralStatus  @default(pending)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  fromDoctor  ClinicUser  @relation("ReferralFrom", fields: [fromDoctorId], references: [id])
  toDoctor    ClinicUser  @relation("ReferralTo", fields: [toDoctorId], references: [id])
}

model PractitionerScheduleRequest {
  id           String   @id @default(uuid())
  clinicId     String
  doctorId     String
  kind         String
  status       String   @default("pending")
  startAt      DateTime
  endAt        DateTime
  reason       String
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  doctor ClinicUser @relation("ScheduleRequester", fields: [doctorId], references: [id], onDelete: Cascade)
  reviewer ClinicUser? @relation("ScheduleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, createdAt])
  @@index([doctorId, createdAt])
}

model DoctorAvailability {
  id             String  @id @default(uuid())
  doctorId       String
  dayOfWeek      Int
  startTime      String
  endTime        String
  effectiveFrom  DateTime? @db.Date
  effectiveUntil DateTime? @db.Date
  isActive       Boolean @default(true)

  doctor ClinicUser @relation(fields: [doctorId], references: [id])

  @@index([doctorId, dayOfWeek, isActive])
}

model DoctorTimeOff {
  id        String   @id @default(uuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String?

  doctor ClinicUser @relation(fields: [doctorId], references: [id])

  @@index([doctorId, startDate, endDate])
}

model DoctorAvailabilityOverride {
  id        String   @id @default(uuid())
  doctorId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor ClinicUser @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startAt, endAt])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
}

model Package {
  id            String        @id @default(uuid())
  clinicId      String
  name          String
  description   String?
  sessionCount  Int?
  price         Decimal?      @db.Decimal(10, 3)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 3)
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic      Clinic           @relation(fields: [clinicId], references: [id])
  patients    Patient[]
  enrollments PatientPackage[]
}

model PatientPackage {
  id            String   @id @default(uuid())
  clinicId      String
  patientId     String
  packageId     String

  sessionsTotal Int?

  creditTotal   Decimal? @db.Decimal(10, 3)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  appointments Appointment[]

  @@index([clinicId, patientId, isActive])
}

model DiscountCode {
  id            String       @id @default(uuid())
  clinicId      String
  code          String
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 3)
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  patients     Patient[]

  @@unique([clinicId, code])
}

model Notification {
  id        String    @id @default(uuid())
  clinicId  String
  userId    String
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  clinic Clinic     @relation(fields: [clinicId], references: [id])
  user   ClinicUser @relation(fields: [userId], references: [id])

  @@index([clinicId, userId, readAt])
}

enum EmailRecipientStatus {
  queued
  processing
  accepted
  delivered
  delayed
  bounced
  complained
  failed
  suppressed
}

model EmailSettings {
  clinicId     String   @id
  replyTo      String?
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  linkedinUrl  String?
  phone        String?
  footerEn     String?
  footerAr     String?
  updatedAt    DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model EmailMessage {
  id          String   @id @default(uuid())
  clinicId    String
  createdById String
  requestId   String
  requestHash String
  locale      String
  subject     String
  body        String
  isTest      Boolean  @default(false)
  createdAt   DateTime @default(now())

  clinic     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  recipients EmailRecipient[]

  @@unique([clinicId, requestId])
  @@index([clinicId, createdAt, id])
}

model EmailRecipient {
  id             String               @id @default(uuid())
  messageId      String
  sourceId       String?
  audience       String
  email          String
  name           String
  subject        String
  fromAddress    String
  html           String
  text           String
  replyTo        String?
  status         EmailRecipientStatus @default(queued)
  providerId     String?              @unique
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  firstAttemptAt DateTime?
  leaseToken     String?
  leaseUntil     DateTime?
  lastError      String?
  lastEventAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, email])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
}

model EmailWebhookReceipt {
  id         String   @id
  providerId String
  type       String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model EmailSuppression {
  id        String   @id @default(uuid())
  clinicId  String
  email     String
  reason    String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, email])
}

model ClinicalNoteTemplate {
  id             String                    @id @default(uuid())
  clinicId       String
  name           String
  nameAr         String?
  status         String                    @default("draft")
  scheduledAt    DateTime?
  revision       Int                       @default(0)
  availableToAll Boolean                   @default(true)
  assignments    Json
  sections       Json
  published      Json?
  publishedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  defaultForClinics Clinic[] @relation("ClinicDefaultNote")

  @@unique([id, clinicId])
  @@index([clinicId, status])
}

model Visit {
  id                      String              @id @default(uuid())
  clinicId                String
  appointmentId           String              @unique
  revision                Int                 @default(0)
  startedAt               DateTime
  finishedAt              DateTime?
  scheduledEndAt          DateTime
  documentationDeadlineAt DateTime
  noteStatus              String              @default("not_started")
  reportStatus            String              @default("pending_note")
  invoiceStatus           String              @default("preparing")
  unlockGrantedAt         DateTime?
  unlockGrantedById       String?
  unlockReason            String?
  context                 Json
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  appointment             Appointment         @relation(fields: [appointmentId, clinicId], references: [id, clinicId], onDelete: Restrict)
  note                    ClinicalNote?
  report                  VisitMedicalReport?
  invoice                 VisitInvoice?
  events                  VisitEvent[]
  documents               VisitDocument[]

  @@unique([id, clinicId])
  @@unique([appointmentId, clinicId])
  @@index([clinicId, startedAt])
  @@index([clinicId, noteStatus, invoiceStatus])
  @@index([documentationDeadlineAt, noteStatus])
}

model ClinicalNote {
  id                String    @id @default(uuid())
  visitId           String    @unique
  clinicId          String
  templateId        String
  sectionsSnapshot  Json
  values            Json
  revision          Int       @default(1)
  authorId          String
  savedAt           DateTime  @default(now())
  signedAt          DateTime?
  signedRevisionId  String?
  visit             Visit     @relation(fields: [visitId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([visitId, clinicId])
  @@index([clinicId])
}

model VisitMedicalReport {
  id                   String    @id @default(uuid())
  visitId              String    @unique
  clinicId             String
  revision             Int       @default(1)
  sections             Json
  sourceNoteRevisionId String
  signedById           String?
  signedAt             DateTime?
  visit                Visit     @relation(fields: [visitId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([visitId, clinicId])
  @@index([clinicId])
}

model VisitInvoice {
  id              String         @id @default(uuid())
  visitId         String         @unique
  clinicId        String
  revision        Int            @default(1)
  number          String?
  currency        String         @default("JOD")
  lineItems       Json
  subtotal        Decimal        @db.Decimal(12, 3)
  discount        Decimal        @default(0) @db.Decimal(12, 3)
  tax             Decimal        @default(0) @db.Decimal(12, 3)
  total           Decimal        @db.Decimal(12, 3)
  packageCoverage Decimal        @default(0) @db.Decimal(12, 3)
  prepayment      Decimal        @default(0) @db.Decimal(12, 3)
  issuedAt        DateTime?
  voidedAt        DateTime?
  visit           Visit          @relation(fields: [visitId, clinicId], references: [id, clinicId], onDelete: Restrict)
  payments        VisitPayment[]

  @@unique([clinicId, number])
  @@unique([id, clinicId])
  @@unique([visitId, clinicId])
  @@index([clinicId, issuedAt])
}

model VisitPayment {
  id          String       @id @default(uuid())
  clinicId    String
  invoiceId   String
  requestId   String
  requestHash String
  amount      Decimal      @db.Decimal(12, 3)
  methodId    String?
  paymentId   String?
  reference   String?
  reason      String?
  actorId     String
  createdAt   DateTime     @default(now())
  invoice     VisitInvoice @relation(fields: [invoiceId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([clinicId, requestId])
  @@index([invoiceId])
}

model VisitEvent {
  id        String   @id @default(uuid())
  clinicId  String
  visitId   String
  actorId   String
  kind      String
  reason    String?
  snapshot  Json?
  createdAt DateTime @default(now())
  visit     Visit    @relation(fields: [visitId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([clinicId, visitId, createdAt])
  @@index([visitId, kind, createdAt])
}

model VisitDocument {
  id         String    @id @default(uuid())
  clinicId   String
  visitId    String
  kind       String
  revision   Int
  snapshot   Json
  pdf        Bytes
  signedById String
  signedAt   DateTime  @default(now())
  releasedAt DateTime?
  visit      Visit     @relation(fields: [visitId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([visitId, kind, revision])
  @@index([clinicId, visitId])
}
