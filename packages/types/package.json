{
  "name": "@clinic/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTTP contracts for clinic-platform (web + api)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
